<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Deep Shadow Layer -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#08090C" />
        </shape>
    </item>
    <!-- Metallic Bevel Rim -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:startColor="#3E424D"
                android:endColor="#1C1D24" />
            <stroke android:width="2dp" android:color="#4F5463" />
        </shape>
    </item>
    <!-- Convex Center Core -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:startColor="#252731"
                android:endColor="#0F1014" />
            <stroke android:width="1.5dp" android:color="#D8C9A9" />
        </shape>
    </item>
</layer-list>

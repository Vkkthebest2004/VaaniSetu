<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & Operator Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="iTantra Emblem"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rx_operator_callsign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:text="COMMAND-HQ (RECEIVER)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="STATIONARY MONITOR &amp; AUDIO SINK"
                    android:textColor="#00E676"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Switch Mode Button -->
            <Button
                android:id="@+id/btn_rx_switch_mode"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip_callsign"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="SWITCH MODE"
                android:textColor="#E5A93C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Channel & RF Frequency LCD Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tactical_lcd"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_rx_channel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="MIL-NET CH 08 • 433.750 MHz"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="RX ACTIVE"
                    android:textColor="#00E676"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_rx_prev_channel"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_callsign"
                    android:text="&lt;"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_rx_channel_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:text="MONITORING CHANNEL 08"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_rx_next_channel"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_callsign"
                    android:text="&gt;"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="MESH LINK: -38 dBm • 100% SNR • ZERO PACKET LOSS"
                android:textColor="#7A8090"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Ingress Signal & Radar Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tactical_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Radar"
                android:src="@drawable/ic_mesh_radar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rx_status_radar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="LISTENING FOR INCOMING FIELD AUDIO"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Auto-decrypting MicroRadio packets via UDP 8989"
                    android:textColor="#6C7282"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_chip_callsign_active" />
        </LinearLayout>

        <!-- Primary Reception Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tactical_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_rx_main_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="LATEST RECEIVED INGRESS"
                    android:textColor="#E5A93C"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btn_rx_replay_audio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_callsign"
                    android:contentDescription="Replay"
                    android:src="@drawable/ic_replay_audio" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rx_main_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:padding="14dp"
                android:text="तत्काल चिकित्सा सहायता और एम्बुलेंस की आवश्यकता है"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Reception Telemetry Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PACKET SIZE"
                        android:textColor="#6C7282"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_rx_tele_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="6 Bytes"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIRTIME SAVINGS"
                        android:textColor="#6C7282"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_rx_tele_saved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="99.96%"
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E2E LATENCY"
                        android:textColor="#6C7282"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_rx_tele_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="580 ms"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Verification & Field Ingress Simulation Suite -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="FIELD INGRESS SIMULATION &amp; TESTING"
            android:textColor="#A0A5B5"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_sim_sender_voice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_callsign"
                android:gravity="center"
                android:text="🎙️ SIMULATE SENDER SPEECH: &quot;गश्त दल सुरक्षित है&quot;"
                android:textColor="#E5A93C"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_sim_sender_medevac"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_callsign"
                android:gravity="center"
                android:text="🚑 SIMULATE TACTICAL MEDEVAC (6 BYTES)"
                android:textColor="#FFB74D"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_sim_sender_distress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_callsign"
                android:gravity="center"
                android:text="🚨 SIMULATE EMERGENCY SOS DISTRESS ALARM"
                android:textColor="#EF5350"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Auto-TTS Option Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tactical_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="AUTO-SYNTHESIZE SPEECH (TTS)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Automatically speaks received transmissions"
                    android:textColor="#6C7282"
                    android:textSize="10sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_auto_tts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07080B"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- ============================================== -->
    <!-- 1. TOP BAR: CHANNEL PILL & 1-TAP MODE SWITCH   -->
    <!-- ============================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Channel Navigation Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tactical_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <Button
                android:id="@+id/btn_prev_channel"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_channel_arrow"
                app:backgroundTint="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_channel_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="CH 08 • 433.750 MHz"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_next_channel"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_channel_arrow"
                app:backgroundTint="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 1-Tap Mode Toggle (TX / RX) -->
        <Button
            android:id="@+id/btn_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_callsign_active"
            app:backgroundTint="@null"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="MODE: TX"
            android:textColor="#E5A93C"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ============================================== -->
    <!-- 2. CENTER HERO STAGE: HUGE 3D PTT BUTTON       -->
    <!-- ============================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing Halo & Tactile PTT Button Container -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <!-- Breathing Halo Pulse Ring -->
            <View
                android:id="@+id/view_ptt_halo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_radar_ring" />

            <!-- Primary 3D Push-To-Talk Button -->
            <ImageButton
                android:id="@+id/btn_ptt_3d"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_ptt_3d_selector"
                android:contentDescription="Push To Talk"
                android:elevation="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ptt_mic" />
        </FrameLayout>

        <!-- Dynamic Hero Status Label -->
        <TextView
            android:id="@+id/tv_ptt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:text="HOLD TO TALK"
            android:textColor="#E5A93C"
            android:textSize="15sp" />

        <!-- Subtitle Context Hint -->
        <TextView
            android:id="@+id/tv_mode_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Press and hold to broadcast offline voice note"
            android:textColor="#6C7182"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- ============================================== -->
    <!-- 3. BOTTOM FLOATING MESSAGE CARD                -->
    <!-- ============================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_tactical_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_msg_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.08"
                android:text="LATEST TRANSMISSION (CH 08)"
                android:textColor="#E5A93C"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_replay_audio"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_callsign"
                android:contentDescription="Replay Audio"
                android:src="@drawable/ic_replay_audio" />
        </LinearLayout>

        <!-- Main Readable Text -->
        <TextView
            android:id="@+id/tv_msg_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:text="तत्काल चिकित्सा सहायता और एम्बुलेंस की आवश्यकता है"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Clean Metric Footer -->
        <TextView
            android:id="@+id/tv_msg_telemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="6 Bytes • 99.96% Saved • 210 ms"
            android:textColor="#00E676"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ============================================== -->
    <!-- 4. BOTTOM ACTION DOCK: 3 CLEAN BUTTONS         -->
    <!-- ============================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1-Click Tactical Macros Sheet Opener -->
        <Button
            android:id="@+id/btn_dock_macros"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_button"
            app:backgroundTint="@null"
            android:text="⚡ MACROS"
            android:textColor="#FFCA28"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Quick Ingress Tester -->
        <Button
            android:id="@+id/btn_dock_test"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_button"
            app:backgroundTint="@null"
            android:text="🎙️ TEST"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Emergency SOS Distress -->
        <Button
            android:id="@+id/btn_dock_sos"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dock_button"
            app:backgroundTint="@null"
            android:text="🚨 SOS"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

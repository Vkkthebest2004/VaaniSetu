<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Top Header & Brand Emblem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="iTantra Emblem"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.15"
                    android:text="iTANTRA TACTICAL"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="AUTHENTICATION &amp; ROLE GATEWAY"
                    android:textColor="#E5A93C"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_clearance_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_callsign"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="SEC-L3"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subheader Info Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tactical_card"
            android:padding="12dp"
            android:text="SELECT OPERATIONAL ROLE TO INITIALIZE TRANSCEIVER ENGINE. BOTH MODES RUN FULLY OFFLINE ON P2P MESH."
            android:textColor="#7E8392"
            android:textSize="11sp" />

        <!-- Role / Mode Selection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="OPERATIONAL MODE"
            android:textColor="#A0A5B5"
            android:textSize="12sp" />

        <!-- Mode Cards Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <!-- Sender Mode Card (TX) -->
            <LinearLayout
                android:id="@+id/card_mode_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mode_card_selected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title_sender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.08"
                            android:text="SENDER MODE (TX)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Field Operator • 3D PTT • Voice Broadcast"
                            android:textColor="#E5A93C"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_mode_sender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Transmits live microphone voice notes, 1-click tactical macros (Medevac, Fire), and priority SOS distress packets."
                    android:textColor="#8C91A0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Receiver Mode Card (RX) -->
            <LinearLayout
                android:id="@+id/card_mode_receiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_mode_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📻"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title_receiver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.08"
                            android:text="RECEIVER MODE (RX)"
                            android:textColor="#9E9E9E"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Command Station • Channel Monitor • Audio Decoders"
                            android:textColor="#7A7E8C"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_mode_receiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:clickable="false" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Listens on active channels, auto-synthesizes speech with neural Indic TTS, verifies CRC16 checksums, and monitors emergency strobes."
                    android:textColor="#686D7C"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Callsign & Authentication Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="OPERATOR CALLSIGN"
            android:textColor="#A0A5B5"
            android:textSize="12sp" />

        <!-- Preset Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_callsign_alpha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_callsign_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="ALPHA-01"
                    android:textColor="#E5A93C"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_callsign_hq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_callsign"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="COMMAND-HQ"
                    android:textColor="#A0A5B5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_callsign_echo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_callsign"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="ECHO-07 (MED)"
                    android:textColor="#A0A5B5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_callsign_bravo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_callsign"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="BRAVO-02"
                    android:textColor="#A0A5B5"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Custom Callsign Field -->
        <EditText
            android:id="@+id/et_operator_callsign"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Or enter tactical ID..."
            android:inputType="textCapCharacters"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="ALPHA-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#4A4E5C"
            android:textSize="14sp" />

        <!-- Tactical Security PIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="TACTICAL SECURITY PIN"
            android:textColor="#A0A5B5"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_tactical_pin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Enter 4-digit PIN..."
                android:inputType="numberPassword"
                android:letterSpacing="0.2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="1947"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A4E5C"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_quick_pin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_callsign"
                android:text="AUTO-PIN"
                android:textColor="#00E676"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_auth_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Default tactical clearance PIN: 1947"
            android:textColor="#6C7282"
            android:textSize="11sp" />

        <!-- Authorize Action Button -->
        <Button
            android:id="@+id/btn_authorize_connect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_auth_button"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="AUTHORIZE &amp; LOAD SENDER (TX)"
            android:textColor="#14151C"
            android:textSize="14sp" />

        <!-- Security Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="100% AIR-GAPPED • ZERO INTERNET DEPENDENCY"
            android:textColor="#424654"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
